ults.cardColors(containerColor \u003d CharcoalSurface),\n                border \u003d BorderStroke(1.dp, RoyalGold),\n                shape \u003d RoundedCornerShape(16.dp)\n            ) {\n                Column(\n                    modifier \u003d Modifier\n                        .fillMaxWidth()\n                        .padding(20.dp),\n                    horizontalAlignment \u003d Alignment.CenterHorizontally\n                ) {\n                    Row(\n                        modifier \u003d Modifier.fillMaxWidth(),\n                        horizontalArrangement \u003d Arrangement.End\n                    ) {\n                        TextButton(onClick \u003d { toggleAppLanguage() }) {\n                            Icon(Icons.Default.Translate, contentDescription \u003d null, tint \u003d RoyalGold)\n                            Spacer(Modifier.width(4.dp))\n                            Text(stringResource(R.string.switch_language), color \u003d RoyalGold)\n                        }\n                    }\n\n                    AsyncImage(\n                        model \u003d profile.profileImageUrl.ifEmpty { R.mipmap.ic_launcher },\n                        contentDescription \u003d \"Ayuba Gombe\",\n                        contentScale \u003d ContentScale.Crop,\n                        modifier \u003d Modifier\n                            .size(110.dp)\n                            .clip(CircleShape)\n                            .border(3.dp, BrightGold, CircleShape)\n                    )\n                    Spacer(Modifier.height(12.dp))\n                    Text(\n                        text \u003d stringResource(R.string.welcome_title),\n                        style \u003d MaterialTheme.typography.titleLarge,\n                        color \u003d RoyalGold,\n                        fontWeight \u003d FontWeight.Bold\n                    )\n                    Spacer(Modifier.height(6.dp))\n                    Text(\n                        text \u003d stringResource(R.string.welcome_subtitle),\n                        style \u003d MaterialTheme.typography.bodyMedium,\n                        color \u003d TextSecondary\n                    )\n                }\n            }\n        }\n\n        // Latest Videos Preview\n        item {\n            Text(\n                text \u003d stringResource(R.string.latest_videos),\n                style \u003d MaterialTheme.typography.titleMedium,\n                color \u003d RoyalGold,\n                fontWeight \u003d FontWeight.Bold\n            )\n        }\n        items(videos.take(3)) { video -\u003e\n            VideoCard(video \u003d video, onClick \u003d { onWatchVideo(video) })\n        }\n\n        // Latest News Preview\n        item {\n            Text(\n                text \u003d stringResource(R.string.latest_news),\n                style \u003d MaterialTheme.typography.titleMedium,\n                color \u003d RoyalGold,\n                fontWeight \u003d FontWeight.Bold\n            )\n        }\n        items(news.take(3)) { item -\u003e\n            NewsCard(newsItem \u003d item)\n        }\n    }\n}\n\n@Composable\nfun VideosScreen(videos: List\u003cVideoItem\u003e, onWatchVideo: (VideoItem) -\u003e Unit) {\n    LazyColumn(\n        modifier \u003d Modifier.fillMaxSize(),\n        contentPadding \u003d PaddingValues(16.dp),\n        verticalArrangement \u003d Arrangement.spacedBy(14.dp)\n    ) {\n        items(videos) { video -\u003e\n            VideoCard(video \u003d video, onClick \u003d { onWatchVideo(video) })\n        }\n    }\n}\n\n@Composable\nfun VideoCard(video: VideoItem, onClick: () -\u003e Unit) {\n    Card(\n        modifier \u003d Modifier\n            .fillMaxWidth()\n            .clickable { onClick() },\n        colors \u003d CardDefaults.cardColors(containerColor \u003d ElevatedCard),\n        border \u003d BorderStroke(0.5.dp, RoyalGold.copy(alpha \u003d 0.5f)),\n        shape \u003d RoundedCornerShape(14.dp)\n    ) {\n        Column {\n            Box(modifier \u003d Modifier.fillMaxWidth().height(190.dp)) {\n                AsyncImage(\n                    model \u003d video.thumbnailUrl,\n                    contentDescription \u003d video.title,\n                    contentScale \u003d ContentScale.Crop,\n                    modifier \u003d Modifier.fillMaxSize()\n                )\n                Icon(\n                    imageVector \u003d Icons.Default.PlayCircleFilled,\n                    contentDescription \u003d \"Play\",\n                    tint \u003d BrightGold,\n                    modifier \u003d Modifier\n                        .size(56.dp)\n                        .align(Alignment.Center)\n                )\n            }\n            Column(modifier \u003d Modifier.padding(14.dp)) {\n                Text(\n                    text \u003d video.title,\n                    style \u003d MaterialTheme.typography.titleMedium,\n                    color \u003d RoyalGold,\n                    fontWeight \u003d FontWeight.SemiBold\n                )\n                Spacer(Modifier.height(4.dp))\n                Text(\n                    text \u003d video.description,\n                    style \u003d MaterialTheme.typography.bodySmall,\n                    color \u003d TextSecondary,\n                    maxLines \u003d 2,\n                    overflow \u003d TextOverflow.Ellipsis\n                )\n            }\n        }\n    }\n}\n\n@Composable\nfun GalleryScreen(photos: List\u003cPhotoItem\u003e) {\n    var selectedPhoto by remember { mutableStateOf\u003cPhotoItem?\u003e(null) }\n\n    LazyVerticalGrid(\n        columns \u003d GridCells.Fixed(2),\n        contentPadding \u003d PaddingValues(12.dp),\n        horizontalArrangement \u003d Arrangement.spacedBy(10.dp),\n        verticalArrangement \u003d Arrangement.spacedBy(10.dp),\n        modifier \u003d Modifier.fillMaxSize()\n    ) {\n        items(photos) { photo -\u003e\n            Card(\n                modifier \u003d Modifier\n                    .aspectRatio(1f)\n                    .clickable { selectedPhoto \u003d photo },\n                border \u003d BorderStroke(1.dp, RoyalGold.copy(alpha \u003d 0.4f)),\n                shape \u003d RoundedCornerShape(12.dp)\n            ) {\n                AsyncImage(\n                    model \u003d photo.imageUrl,\n                    contentDescription \u003d photo.title,\n                    contentScale \u003d ContentScale.Crop,\n                    modifier \u003d Modifier.fillMaxSize()\n                )\n            }\n        }\n    }\n\n    selectedPhoto?.let { photo -\u003e\n        Dialog(onDismissRequest \u003d { selectedPhoto \u003d null }) {\n            Card(\n                colors \u003d CardDefaults.cardColors(containerColor \u003d ObsidianBlack),\n                border \u003d BorderStroke(1.dp, RoyalGold)\n            ) {\n                Column(modifier \u003d Modifier.padding(12.dp)) {\n                    AsyncImage(\n                        model \u003d photo.imageUrl,\n                        contentDescription \u003d photo.title,\n                        contentScale \u003d ContentScale.Fit,\n                        modifier \u003d Modifier\n                            .fillMaxWidth()\n                            .heightIn(max \u003d 420.dp)\n                    )\n                    Spacer(Modifier.height(8.dp))\n                    Text(photo.title, color \u003d RoyalGold, fontWeight \u003d FontWeight.Bold)\n                }\n            }\n        }\n    }\n}\n\n@Composable\nfun NewsScreen(news: List\u003cNewsItem\u003e) {\n    LazyColumn(\n        modifier \u003d Modifier.fillMaxSize(),\n        contentPadding \u003d PaddingValues(16.dp),\n        verticalArrangement \u003d Arrangement.spacedBy(14.dp)\n    ) {\n        items(news) { item -\u003e NewsCard(item) }\n    }\n}\n\n@Composable\nfun NewsCard(newsItem: NewsItem) {\n    Card(\n        modifier \u003d Modifier.fillMaxWidth(),\n        colors \u003d CardDefaults.cardColors(containerColor \u003d ElevatedCard),\n        border \u003d BorderStroke(0.5.dp, RoyalGold.copy(alpha \u003d 0.4f)),\n        shape \u003d RoundedCornerShape(14.dp)\n    ) {\n        Column(modifier \u003d Modifier.padding(14.dp)) {\n            if (newsItem.imageUrl.isNotBlank()) {\n                AsyncImage(\n                    model \u003d newsItem.imageUrl,\n                    contentDescription \u003d newsItem.title,\n                    contentScale \u003d ContentScale.Crop,\n                    modifier \u003d Modifier\n                        .fillMaxWidth()\n                        .height(160.dp)\n                        .clip(RoundedCornerShape(10.dp))\n                )\n                Spacer(Modifier.height(10.dp))\n            }\n            Text(newsItem.title, color \u003d RoyalGold, style \u003d MaterialTheme.typography.titleMedium, fontWeight \u003d FontWeight.Bold)\n            Spacer(Modifier.height(6.dp))\n            Text(newsItem.content, style \u003d MaterialTheme.typography.bodyMedium, color \u003d TextPrimary)\n        }\n    }\n}\n\n@OptIn(ExperimentalFoundationApi::class)\n@Composable\nfun AboutContactScreen(\n    profile: ProfileInfo,\n    onOpenHiddenAdmin: () -\u003e Unit\n) {\n    val context \u003d LocalContext.current\n    val isHausa \u003d AppCompatDelegate.getApplicationLocales().toLanguageTags().startsWith(\"ha\")\n\n    LazyColumn(\n        modifier \u003d Modifier.fillMaxSize(),\n        contentPadding \u003d PaddingValues(16.dp),\n        verticalArrangement \u003d Arrangement.spacedBy(16.dp)\n    ) {\n        item {\n            Card(\n                colors \u003d CardDefaults.cardColors(containerColor \u003d CharcoalSurface),\n                border \u003d BorderStroke(1.dp, RoyalGold)\n            ) {\n                Column(modifier \u003d Modifier.padding(16.dp)) {\n                    Text(\n                        text \u003d stringResource(R.string.about_title),\n              