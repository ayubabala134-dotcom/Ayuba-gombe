out\"\u003eGame da Mu\u003c/string\u003e\n    \u003cstring name\u003d\"welcome_title\"\u003eBarka da zuwa Ayuba Gombe Digital\u003c/string\u003e\n    \u003cstring name\u003d\"welcome_subtitle\"\u003eFina-finan Hausa na Ayuba da Suraj, Zane-zane da Labarai\u003c/string\u003e\n    \u003cstring name\u003d\"latest_videos\"\u003eSabbin Fina-finan Hausa\u003c/string\u003e\n    \u003cstring name\u003d\"latest_news\"\u003eSabbin Labarai\u003c/string\u003e\n    \u003cstring name\u003d\"about_title\"\u003eTarihin Ayuba Gombe\u003c/string\u003e\n    \u003cstring name\u003d\"contact_whatsapp\"\u003eTuntuɓa ta WhatsApp (09036045242)\u003c/string\u003e\n    \u003cstring name\u003d\"social_media\"\u003eShafukan Sada Zumunta\u003c/string\u003e\n    \u003cstring name\u003d\"data_notice\"\u003eKallon bidiyo yana amfani da datar intanet.\u003c/string\u003e\n    \u003cstring name\u003d\"empty_videos\"\u003eBa a dora fina-finai ba tukuna.\u003c/string\u003e\n    \u003cstring name\u003d\"empty_photos\"\u003eBa a dora hotuna ba tukuna.\u003c/string\u003e\n    \u003cstring name\u003d\"empty_news\"\u003eBabu sabbin labarai tukuna.\u003c/string\u003e\n\u003c/resources\u003e\n```\n\n---\n\n## 3. Theme, Models \u0026 Cloud Repository\n\n### `ui/theme/Theme.kt`\n```kotlin\npackage com.ayubagombe.digital.ui.theme\n\nimport androidx.compose.material3.MaterialTheme\nimport androidx.compose.material3.darkColorScheme\nimport androidx.compose.runtime.Composable\nimport androidx.compose.ui.graphics.Color\n\nval ObsidianBlack \u003d Color(0xFF0B0B0D)\nval CharcoalSurface \u003d Color(0xFF16161B)\nval ElevatedCard \u003d Color(0xFF1F1F26)\nval RoyalGold \u003d Color(0xFFD4AF37)\nval BrightGold \u003d Color(0xFFFFD700)\nval SoftGold \u003d Color(0xFFF3E5AB)\nval TextPrimary \u003d Color(0xFFF5F5F5)\nval TextSecondary \u003d Color(0xFFB0B0B8)\nval ErrorRed \u003d Color(0xFFCF6679)\n\nprivate val BlackGoldColorScheme \u003d darkColorScheme(\n    primary \u003d RoyalGold,\n    onPrimary \u003d ObsidianBlack,\n    secondary \u003d BrightGold,\n    onSecondary \u003d ObsidianBlack,\n    background \u003d ObsidianBlack,\n    onBackground \u003d TextPrimary,\n    surface \u003d CharcoalSurface,\n    onSurface \u003d TextPrimary,\n    surfaceVariant \u003d ElevatedCard,\n    onSurfaceVariant \u003d TextSecondary,\n    error \u003d ErrorRed\n)\n\n@Composable\nfun AyubaGombeTheme(content: @Composable () -\u003e Unit) {\n    MaterialTheme(\n        colorScheme \u003d BlackGoldColorScheme,\n        content \u003d content\n    )\n}\n```\n\n### `data/Models.kt`\n```kotlin\npackage com.ayubagombe.digital.data\n\ndata class VideoItem(\n    val id: String \u003d \"\",\n    val title: String \u003d \"\",\n    val description: String \u003d \"\",\n    val category: String \u003d \"Ayuba \u0026 Suraj Hausa Movie\",\n    val videoUrl: String \u003d \"\",\n    val thumbnailUrl: String \u003d \"\",\n    val createdAt: Long \u003d System.currentTimeMillis()\n)\n\ndata class PhotoItem(\n    val id: String \u003d \"\",\n    val title: String \u003d \"\",\n    val imageUrl: String \u003d \"\",\n    val createdAt: Long \u003d System.currentTimeMillis()\n)\n\ndata class NewsItem(\n    val id: String \u003d \"\",\n    val title: String \u003d \"\",\n    val content: String \u003d \"\",\n    val imageUrl: String \u003d \"\",\n    val createdAt: Long \u003d System.currentTimeMillis()\n)\n\ndata class ProfileInfo(\n    val name: String \u003d \"Ayuba Gombe\",\n    val profileImageUrl: String \u003d \"\",\n    val bioEnglish: String \u003d \"Ayuba Gombe is a creative Hausa filmmaker, digital media producer (Ayuba \u0026 Suraj Hausa Movies), and advocate for a Greater Gombe State—committed to Good Governance, Quality Education, Better Healthcare, More Jobs, and People\u0027s Welfare.\",\n    val bioHausa: String \u003d \"Ayuba Gombe fitaccen mai shirya fina-finan Hausa ne (Ayuba da Suraj), kwararre a harkar yada labarai na zamani, kuma mai fafutukar ci gaban Jihar Gombe—domin Shugabanci Nagari, Ingantaccen Ilimi, Lafiya, Samar da Ayyukan Yi da Jin Dadin Al\u0027umma.\",\n    val whatsapp: String \u003d \"09036045242\"\n)\n```\n\n### `data/AyubaRepository.kt`\n```kotlin\npackage com.ayubagombe.digital.data\n\nimport android.net.Uri\nimport com.google.firebase.auth.FirebaseAuth\nimport com.google.firebase.firestore.FirebaseFirestore\nimport com.google.firebase.firestore.Query\nimport com.google.firebase.firestore.SetOptions\nimport com.google.firebase.storage.FirebaseStorage\nimport kotlinx.coroutines.channels.awaitClose\nimport kotlinx.coroutines.flow.Flow\nimport kotlinx.coroutines.flow.callbackFlow\nimport kotlinx.coroutines.tasks.await\nimport java.util.UUID\n\nclass AyubaRepository {\n    private val db \u003d FirebaseFirestore.getInstance()\n    private val storage \u003d FirebaseStorage.getInstance()\n    private val auth \u003d FirebaseAuth.getInstance()\n\n    fun observeVideos(): Flow\u003cList\u003cVideoItem\u003e\u003e \u003d callbackFlow {\n        val listener \u003d db.collection(\"videos\")\n            .orderBy(\"createdAt\", Query.Direction.DESCENDING)\n            .addSnapshotListener { snap, _ -\u003e\n                val list \u003d snap?.documents?.mapNotNull {\n                    it.toObject(VideoItem::class.java)?.copy(id \u003d it.id)\n                } ?: emptyList()\n                trySend(list)\n            }\n        awaitClose { listener.remove() }\n    }\n\n    fun observePhotos(): Flow\u003cList\u003cPhotoItem\u003e\u003e \u003d callbackFlow {\n        val listener \u003d db.collection(\"photos\")\n            .orderBy(\"createdAt\", Query.Direction.DESCENDING)\n            .addSnapshotListener { snap, _ -\u003e\n                val list \u003d snap?.documents?.mapNotNull {\n                    it.toObject(PhotoItem::class.java)?.copy(id \u003d it.id)\n                } ?: emptyList()\n                trySend(list)\n            }\n        awaitClose { listener.remove() }\n    }\n\n    fun observeNews(): Flow\u003cList\u003cNewsItem\u003e\u003e \u003d callbackFlow {\n        val listener \u003d db.collection(\"news\")\n            .orderBy(\"createdAt\", Query.Direction.DESCENDING)\n            .addSnapshotListener { snap, _ -\u003e\n                val list \u003d snap?.documents?.mapNotNull {\n                    it.toObject(NewsItem::class.java)?.copy(id \u003d it.id)\n                } ?: emptyList()\n                trySend(list)\n            }\n        awaitClose { listener.remove() }\n    }\n\n    fun observeProfile(): Flow\u003cProfileInfo\u003e \u003d callbackFlow {\n        val listener \u003d db.collection(\"app_config\").document(\"profile\")\n            .addSnapshotListener { snap, _ -\u003e\n                val profile \u003d snap?.toObject(ProfileInfo::class.java) ?: ProfileInfo()\n                trySend(profile)\n            }\n        awaitClose { listener.remove() }\n    }\n\n    suspend fun signInAdmin(email: String, password: String): Result\u003cUnit\u003e \u003d runCatching {\n        auth.signInWithEmailAndPassword(email, password).await()\n    }\n\n    fun isAdminSignedIn(): Boolean \u003d auth.currentUser !\u003d null\n\n    fun signOutAdmin() {\n        auth.signOut()\n    }\n\n    private suspend fun uploadFile(\n        uri: Uri,\n        folder: String,\n        onProgress: (Float) -\u003e Unit\n    ): String {\n        val ref \u003d storage.reference.child(\"$folder/${UUID.randomUUID()}\")\n        val uploadTask \u003d ref.putFile(uri)\n        uploadTask.addOnProgressListener { taskSnapshot -\u003e\n            if (taskSnapshot.totalByteCount \u003e 0) {\n                onProgress(taskSnapshot.bytesTransferred.toFloat() / taskSnapshot.totalByteCount)\n            }\n        }.await()\n        return ref.downloadUrl.await().toString()\n    }\n\n    suspend fun uploadVideo(\n        title: String,\n        description: String,\n        videoUri: Uri,\n        thumbnailUri: Uri,\n        onProgress: (Float) -\u003e Unit\n    ) {\n        val thumbUrl \u003d uploadFile(thumbnailUri, \"thumbnails\") { onProgress(it * 0.2f) }\n        val videoUrl \u003d uploadFile(videoUri, \"videos\") { onProgress(0.2f + it * 0.8f) }\n        val item \u003d VideoItem(\n            title \u003d title,\n            description \u003d description,\n            videoUrl \u003d videoUrl,\n            thumbnailUrl \u003d thumbUrl\n        )\n        db.collection(\"videos\").add(item).await()\n    }\n\n    suspend fun updateVideo(id: String, title: String, description: String) {\n        db.collection(\"videos\").document(id)\n            .update(mapOf(\"title\" to title, \"description\" to description)).await()\n    }\n\n    suspend fun deleteVideo(id: String) {\n        db.collection(\"videos\").document(id).delete().await()\n    }\n\n    suspend fun uploadPhoto(title: String, imageUri: Uri, onProgress: (Float) -\u003e Unit) {\n        val url \u003d uploadFile(imageUri, \"photos\", onProgress)\n        db.collection(\"photos\").add(PhotoItem(title \u003d title, imageUrl \u003d url)).await()\n    }\n\n    suspend fun deletePhoto(id: String) {\n        db.collection(\"photos\").document(id).delete().await()\n    }\n\n    suspend fun publishNews(title: String, content: String, imageUri: Uri?, onProgress: (Float) -\u003e Unit) {\n        val imageUrl \u003d imageUri?.let { uploadFile(it, \"news\", onProgress) } ?: \"\"\n        db.collection(\"news\").add(NewsItem(title \u003d title, content \u003d content, imageUrl \u003d imageUrl)).await()\n    }\n\n    suspend fun updateNews(id: String, title: String, content: String) {\n        db.collection(\"news\").document(id)\n            .update(mapOf(\"title\" to title, \"content\" to content)).await()\n    }\n\n    suspend fun deleteNews(id: String) {\n        db.collection(\"news\").document(id).delete().await()\n    }\n\n    suspend fun updateProfilePicture(imageUri: Uri, onProgress: (Float) -\u003e Unit) {\n        val url \u003d uploadFile(imageUri, \"profile\", onProgress)\n        db.collection(\"app_config\").document(\"profile\")\n            .set(mapOf(\"profileImageUrl\" to url), SetOptions.merge())\n            .await()\n    }\n}\n```\n\n---\n\n## 4. Screens (`PublicScreens.kt`, `VideoPlayerScreen.kt`, `AdminScreen.kt`)\n\n### `ui/screens/VideoPlayerScreen.kt`\n```kotlin\npackage com.ayubagombe.digital.ui.screens\n\nimport androidx.activity.compose.BackHandler\nimport androidx.annotation.OptIn\nimport androidx.compose.foundation.background\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.material.icons.Icons\nimport androidx.compose.material.icons.automirrored.filled.ArrowBack\nimport androidx.compose.material3.*\nimport androidx.compose.runtime.*\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.platform.LocalContext\nimport androidx.compose.ui.res.stringResource\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.viewinterop.AndroidView\nimport androidx.media3.common.MediaItem\nimport androidx.media3.common.util.UnstableApi\nimport androidx.media3.exoplayer.ExoPlayer\nimport androidx.media3.ui.PlayerView\nimport com.ayubagombe.digital.R\nimport com.ayubagombe.digital.data.VideoItem\nimport com.ayubagombe.digital.ui.theme.ObsidianBlack\nimport com.ayubagombe.digital.ui.theme.RoyalGold\nimport com.ayubagombe.digital.ui.theme.TextSecondary\n\n@OptIn(UnstableApi::class)\n@Composable\nfun VideoPlayerScreen(video: VideoItem, onBack: () -\u003e Unit) {\n    BackHandler { onBack() }\n    val context \u003d LocalContext.current\n\n    val exoPlayer \u003d remember(video.videoUrl) {\n        ExoPlayer.Builder(context).build().apply {\n            setMediaItem(MediaItem.fromUri(video.videoUrl))\n            prepare()\n            playWhenReady \u003d true\n        }\n    }\n\n    DisposableEffect(Unit) {\n        onDispose { exoPlayer.release() }\n    }\n\n    Column(\n        modifier \u003d Modifier\n            .fillMaxSize()\n            .background(Obsidia